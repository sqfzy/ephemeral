#!/usr/bin/env bash
# scripts/lat — single-command runner for the latency benchmark.
#
#     sudo ./scripts/lat <scenario> [--dpdk]
#
# Reads benchmarks/latency/bench.conf, manages NIC-B state transitions
# (host kernel ↔ bench_ns kernel ↔ vfio-pci) idempotently, and execs the
# matching lat_<scenario>[_dpdk] binary. The binary itself does the
# fork-mock + setns + run-client dance — this script is just the host-
# level state machine that gets the network into the right shape first.
#
# State transitions are detected and announced; reruns of the same
# scenario take the fast path (no transition).

set -euo pipefail

# ── Paths ────────────────────────────────────────────────────────────
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# Resolve repo root so build/ + bench.conf + .dpdk_state stay correct no
# matter where this script lives.
if PROJECT_DIR=$(git -C "$SCRIPT_DIR" rev-parse --show-toplevel 2>/dev/null); then
    :
else
    PROJECT_DIR="$SCRIPT_DIR"
    while [[ "$PROJECT_DIR" != "/" && ! -d "$PROJECT_DIR/eph-dpdk" ]]; do
        PROJECT_DIR="$(dirname "$PROJECT_DIR")"
    done
    [[ "$PROJECT_DIR" == "/" ]] && { echo "cannot locate project root from $SCRIPT_DIR" >&2; exit 1; }
fi
CONFIG_FILE="${BENCH_CONFIG:-$PROJECT_DIR/benchmarks/latency/bench.conf}"
DPDK_SETUP="$PROJECT_DIR/eph-dpdk/scripts/dpdk-setup.sh"
DPDK_TEARDOWN="$PROJECT_DIR/eph-dpdk/scripts/dpdk-teardown.sh"

# ── Color & logging ──────────────────────────────────────────────────
if [[ -t 1 ]] && [[ -z "${NO_COLOR:-}" ]]; then
    RED=$'\033[0;31m'; GREEN=$'\033[0;32m'; YELLOW=$'\033[1;33m'
    BLUE=$'\033[0;34m'; CYAN=$'\033[0;36m'; BOLD=$'\033[1m'; NC=$'\033[0m'
else
    RED=''; GREEN=''; YELLOW=''; BLUE=''; CYAN=''; BOLD=''; NC=''
fi
log_info()  { printf '%s✓%s  %s\n' "$GREEN" "$NC" "$*"; }
log_warn()  { printf '%s⚠%s  %s\n' "$YELLOW" "$NC" "$*" >&2; }
log_error() { printf '%s✗%s  %s%s%s\n' "$RED" "$NC" "$BOLD" "$*" "$NC" >&2; }
log_step()  { printf '%sℹ%s  %s\n' "$CYAN" "$NC" "$*"; }
die() { log_error "$1"; [[ -n "${2:-}" ]] && printf '   %s\n' "$2" >&2; exit 1; }

usage() {
    cat <<EOF
${BOLD}lat${NC} — single-command latency benchmark runner

  ${BOLD}sudo ./benchmarks/latency/lat <scenario> [--dpdk]${NC}

Scenarios:
  tcp           raw TCP RTT
  udp           raw UDP RTT
  ws            plain WebSocket RTT
  ex_market     exchange bookTicker push (1-leg)

Flags:
  --dpdk        use the DPDK client variant (kernel mock unchanged)
  -h, --help    show this help

All other settings (NIC names, IPs, CPUs, payload sweeps, exchange tuning)
live in ${CONFIG_FILE#$PROJECT_DIR/}.

NIC-B state is managed automatically: first run sets up bench_ns or binds
to vfio-pci as needed; subsequent runs in the same mode reuse it. Switching
modes triggers an announced transition.
EOF
}

# ── Parse args ───────────────────────────────────────────────────────
SCENARIO=""
DPDK=false
while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help) usage; exit 0 ;;
        --dpdk)    DPDK=true; shift ;;
        -*)        die "unknown flag: $1" "Run $0 --help" ;;
        *)         [[ -z "$SCENARIO" ]] || die "unexpected positional: $1"
                   SCENARIO="$1"; shift ;;
    esac
done
[[ -n "$SCENARIO" ]] || { usage; exit 1; }

case "$SCENARIO" in
    tcp|udp|ws|ex_market) ;;
    *) die "unknown scenario: $SCENARIO" "Run $0 --help" ;;
esac

[[ $EUID -eq 0 ]] || die "must run as root" "sudo $0 $SCENARIO $*"
[[ -f "$CONFIG_FILE" ]] || die "config not found: $CONFIG_FILE"

# ── Load config (just the network/NIC fields — payload tuning is read by
#    the binary directly) ─────────────────────────────────────────────
# shellcheck disable=SC1090
source "$CONFIG_FILE"
[[ -n "${NIC_A:-}"      ]] || die "NIC_A is not set in $CONFIG_FILE"
[[ -n "${NIC_B:-}"      ]] || die "NIC_B is not set in $CONFIG_FILE"
[[ -n "${LOCAL_IP:-}"   ]] || die "LOCAL_IP is not set in $CONFIG_FILE"
[[ -n "${GATEWAY_IP:-}" ]] || die "GATEWAY_IP is not set in $CONFIG_FILE"

# ── Locate the binary ────────────────────────────────────────────────
detect_build_dir() {
    for d in \
        "$PROJECT_DIR/build/linux/arm64/release" \
        "$PROJECT_DIR/build/linux/aarch64/release" \
        "$PROJECT_DIR/build/linux/x86_64/release"; do
        if [[ -d "$d" ]]; then echo "$d"; return; fi
    done
    die "cannot find xmake build dir under $PROJECT_DIR/build/"
}
BUILD_DIR=$(detect_build_dir)

BINARY_NAME="lat_${SCENARIO}"
[[ "$DPDK" == true ]] && BINARY_NAME="${BINARY_NAME}_dpdk"
BINARY="$BUILD_DIR/$BINARY_NAME"
[[ -x "$BINARY" ]] || die "binary not found: $BINARY" \
    "Build with: xmake build $BINARY_NAME"

# ── Resolve NIC_B's PCI address ──────────────────────────────────────
#
# A NIC bound to vfio-pci has no /sys/class/net entry, so we can't get
# its PCI address from the netdev path. We try (in order):
#
#   1. $NIC_B_PCI from bench.conf (explicit)
#   2. readlink /sys/class/net/$NIC_B/device (works when NIC is on a
#      kernel driver, even if no netdev was created — see "wedged"
#      handling below)
#   3. cached DPDK_PCI from .dpdk_state (set by dpdk-setup.sh)
#
# Returns empty string if none work; callers handle that explicitly.
nic_b_pci() {
    if [[ -n "${NIC_B_PCI:-}" ]]; then
        echo "$NIC_B_PCI"; return
    fi
    if [[ -e "/sys/class/net/$NIC_B/device" ]]; then
        local pci
        pci=$(basename "$(readlink -f "/sys/class/net/$NIC_B/device")")
        [[ -n "$pci" && "$pci" != "device" ]] && { echo "$pci"; return; }
    fi
    if [[ -f "$PROJECT_DIR/.dpdk_state" ]] && \
       grep -q "DPDK_IFACE=\"$NIC_B\"" "$PROJECT_DIR/.dpdk_state" 2>/dev/null; then
        grep -oP 'DPDK_PCI="\K[^"]+' "$PROJECT_DIR/.dpdk_state"
        return
    fi
    echo ""
}

# Driver currently bound to a PCI device, or "" if none.
pci_driver() {
    local pci="$1"
    [[ -n "$pci" && -e "/sys/bus/pci/devices/$pci" ]] || { echo ""; return; }
    basename "$(readlink -f "/sys/bus/pci/devices/$pci/driver" 2>/dev/null)" 2>/dev/null || echo ""
}

# Does this PCI device have a kernel netdev attached?
# Used to detect "wedged" state: kernel driver bound but no netdev
# materialised — happens occasionally after a DPDK process exits and
# the kernel auto-rebinds ena before the netdev is recreated.
pci_has_netdev() {
    local pci="$1"
    [[ -n "$pci" ]] || return 1
    [[ -n "$(ls "/sys/bus/pci/devices/$pci/net" 2>/dev/null)" ]]
}

# Recover from a wedged state by unbinding and rebinding the driver.
# Idempotent: if the netdev already exists, returns immediately.
unwedge_nic() {
    local pci drv
    pci=$(nic_b_pci)
    [[ -n "$pci" ]] || return 1
    drv=$(pci_driver "$pci")
    if [[ -z "$drv" ]]; then
        log_warn "$NIC_B (PCI $pci) has no driver bound; cannot unwedge"
        return 1
    fi
    if pci_has_netdev "$pci"; then
        return 0  # not wedged
    fi
    log_warn "$NIC_B (PCI $pci) is wedged: $drv driver bound but no netdev"
    log_step "Auto-recovery: unbind/rebind $drv on $pci"
    echo "$pci" > "/sys/bus/pci/drivers/$drv/unbind" 2>/dev/null || true
    sleep 1
    echo "$pci" > "/sys/bus/pci/drivers/$drv/bind" 2>/dev/null || true
    # Wait up to 3 s for the netdev to materialise.
    for _ in 1 2 3 4 5 6; do
        if ip link show "$NIC_B" &>/dev/null; then
            log_info "wedge recovered: $NIC_B back in host ns"
            return 0
        fi
        sleep 0.5
    done
    log_error "wedge auto-recovery did not produce a netdev within 3s"
    return 1
}

# ── Detect current NIC-B state ───────────────────────────────────────
#
#   host       — NIC_B exists in the host ns and is not in any netns
#   bench_ns   — NIC_B exists inside bench_ns
#   dpdk       — NIC_B's PCI device is bound to vfio-pci
#   wedged     — NIC_B's PCI device has a kernel driver bound but no
#                netdev (transient race after dpdk process exit)
#   unknown    — none of the above (e.g. NIC_B PCI not resolvable)
#
# Detection is sysfs-driven: we resolve NIC_B's PCI address (via
# bench.conf, /sys/class/net, or .dpdk_state cache) and read the
# driver binding directly. The .dpdk_state file is now just a
# convenience hint, not the source of truth.
detect_nic_b_state() {
    if ip netns list 2>/dev/null | grep -qw bench_ns && \
       ip netns exec bench_ns ip link show "$NIC_B" &>/dev/null; then
        echo "bench_ns"; return
    fi
    local pci drv
    pci=$(nic_b_pci)
    if [[ -n "$pci" ]]; then
        drv=$(pci_driver "$pci")
        if [[ "$drv" == "vfio-pci" ]]; then
            echo "dpdk"; return
        fi
        if [[ -n "$drv" ]] && ! pci_has_netdev "$pci"; then
            echo "wedged"; return
        fi
    fi
    if ip link show "$NIC_B" &>/dev/null; then
        echo "host"; return
    fi
    echo "unknown"
}

# Wait for a netdev (in either host or a named netns) to become visible.
# Used by post-condition checks to tolerate brief transient races where
# the kernel needs a beat to materialise the link after a driver bind
# or netns move.
wait_for_link() {
    local ns="$1"  # "" for host ns, otherwise a netns name
    local iface="$2"
    local timeout_ds=${3:-20}  # deciseconds (default 2s)
    for _ in $(seq 1 "$timeout_ds"); do
        if [[ -z "$ns" ]]; then
            ip link show "$iface" &>/dev/null && return 0
        else
            ip netns exec "$ns" ip link show "$iface" &>/dev/null && return 0
        fi
        sleep 0.1
    done
    return 1
}

# ── State transitions (idempotent) ───────────────────────────────────
host_to_bench_ns() {
    log_step "NIC-B: host → bench_ns"
    ip netns add bench_ns 2>/dev/null || true

    # Idempotency: if NIC_B is already in bench_ns, skip the move.
    # Otherwise `ip link set ... netns bench_ns` would fail with
    # "Cannot find device" because the NIC is no longer in host ns.
    if ! ip netns exec bench_ns ip link show "$NIC_B" &>/dev/null; then
        local prefix
        prefix=$(ip -4 addr show "$NIC_B" 2>/dev/null \
            | grep -oE 'inet [0-9./]+' | head -1 | awk '{print $2}' \
            | grep -oE '/[0-9]+' || true)
        local cidr="${LOCAL_IP}${prefix:-/20}"

        ip link set "$NIC_B" netns bench_ns
        ip netns exec bench_ns ip addr add "$cidr" dev "$NIC_B"
        ip netns exec bench_ns ip link set "$NIC_B" up
        ip netns exec bench_ns ip link set lo up
        # Default route via the configured gateway so the bench client
        # can reach SERVER_IP (which lives on NIC-A in the host ns).
        ip netns exec bench_ns ip route add default \
            via "$GATEWAY_IP" dev "$NIC_B" 2>/dev/null || true
        log_info "bench_ns ready ($NIC_B = $cidr → $GATEWAY_IP)"
    else
        log_info "bench_ns already has $NIC_B (idempotent no-op)"
    fi
}

bench_ns_to_host() {
    log_step "NIC-B: bench_ns → host"
    ip netns exec bench_ns ip link set "$NIC_B" netns 1 2>/dev/null || true
    ip netns del bench_ns 2>/dev/null || true
    ip link set "$NIC_B" up 2>/dev/null || true
}

host_to_dpdk() {
    log_step "NIC-B: host → vfio-pci"
    [[ -x "$DPDK_SETUP" ]] || \
        die "dpdk-setup.sh not found at $DPDK_SETUP"
    local pci
    pci=$(nic_b_pci)
    [[ -n "$pci" ]] || \
        die "cannot determine PCI for $NIC_B" \
            "Set NIC_B_PCI=0000:XX:YY.Z in $CONFIG_FILE if /sys/class/net/$NIC_B is missing."
    if ! DPDK_PCI="$pci" DPDK_IFACE="$NIC_B" "$DPDK_SETUP" -y; then
        die "dpdk-setup.sh failed" \
            "Check the output above. Run 'sudo $DPDK_SETUP --check-only' to diagnose."
    fi
    # Post-condition: NIC_B must NOT be visible as a kernel interface,
    # and the PCI device must be bound to vfio-pci. Poll briefly to
    # tolerate the kernel taking a beat to release the netdev.
    local ok=false
    for _ in 1 2 3 4 5; do
        if ! ip link show "$NIC_B" &>/dev/null && \
           [[ "$(pci_driver "$pci")" == "vfio-pci" ]]; then
            ok=true; break
        fi
        sleep 0.2
    done
    $ok || die "dpdk-setup reported success but $NIC_B is still a kernel interface" \
        "Check 'dpdk-devbind.py --status' — the bind may have partially completed."
    log_info "$NIC_B (PCI $pci) bound to vfio-pci"
}

dpdk_to_host() {
    log_step "NIC-B: vfio-pci → host"
    [[ -x "$DPDK_TEARDOWN" ]] || \
        die "dpdk-teardown.sh not found at $DPDK_TEARDOWN"
    # Do NOT swallow failures: dpdk-teardown.sh refuses to unbind when a
    # live DPDK process (possibly a third-party one) is holding the PCI
    # device. Silently ignoring that turns the next transition into a
    # confusing "Cannot find device <NIC_B>" from `ip link set netns`.
    if ! "$DPDK_TEARDOWN"; then
        die "dpdk-teardown.sh failed — NIC-B still bound to vfio-pci" \
            "A DPDK process may be holding the device. Check with:
   ps -ef | grep -i dpdk
   sudo $DPDK_TEARDOWN           # re-run to see which process
After killing the blocker (or using --force at your own risk), retry this command."
    fi
    # Post-condition: NIC_B must now be a kernel interface again. Poll
    # briefly because the kernel can take a beat to (re)create the
    # netdev after a driver bind.
    if ! wait_for_link "" "$NIC_B" 20; then
        # Maybe we hit the wedged state — try auto-recovery once.
        if unwedge_nic && wait_for_link "" "$NIC_B" 20; then
            : # recovered
        else
            die "teardown reported success but $NIC_B is not back in the host ns" \
                "Check 'dpdk-devbind.py --status' and 'ip link' to diagnose."
        fi
    fi
}

# ── Drive transitions toward the desired state ──────────────────────
DESIRED="bench_ns"
[[ "$DPDK" == true ]] && DESIRED="dpdk"

current=$(detect_nic_b_state)
log_info "NIC-B current state: $current  →  desired: $DESIRED"

# A wedged NIC (driver bound but no netdev) is recoverable in-place by
# unbind/rebind. Recover BEFORE running the transition switch so the
# normal `host → ...` paths can apply.
if [[ "$current" == "wedged" ]]; then
    log_warn "NIC-B in wedged state; attempting auto-recovery before transition"
    if unwedge_nic; then
        current=$(detect_nic_b_state)
        log_info "NIC-B post-recovery state: $current"
    else
        die "auto-recovery failed for $NIC_B" \
            "Manual fix: sudo bash -c 'echo $(nic_b_pci) > /sys/bus/pci/drivers/$(pci_driver "$(nic_b_pci)")/unbind && sleep 1 && echo $(nic_b_pci) > /sys/bus/pci/drivers/$(pci_driver "$(nic_b_pci)")/bind'"
    fi
fi

case "$current,$DESIRED" in
    bench_ns,bench_ns|dpdk,dpdk)
        : # already in the right state
        ;;
    host,bench_ns)
        host_to_bench_ns
        ;;
    host,dpdk)
        host_to_dpdk
        ;;
    bench_ns,dpdk)
        bench_ns_to_host
        host_to_dpdk
        ;;
    dpdk,bench_ns)
        dpdk_to_host
        # dpdk-teardown.sh re-binds to the kernel driver and brings the
        # link back up; from there we go host → bench_ns.
        host_to_bench_ns
        ;;
    unknown,*)
        die "cannot determine $NIC_B's state" \
            "Tried: bench_ns membership, sysfs PCI driver lookup (via /sys/class/net/$NIC_B/device, .dpdk_state cache, and bench.conf NIC_B_PCI), host kernel netdev. None matched.

If $NIC_B is permanently bound to vfio-pci on this host, set NIC_B_PCI=0000:XX:YY.Z explicitly in $CONFIG_FILE so the wrapper can find it without /sys/class/net.

Otherwise check 'ip link', 'lspci -k', and the .dpdk_state file to diagnose."
        ;;
    *)
        die "unhandled transition: $current → $DESIRED"
        ;;
esac

# ── Exec the bench binary ────────────────────────────────────────────
printf '\n%s%s── lat %s%s ──%s\n' "$BOLD" "$BLUE" "$SCENARIO" \
    "$([ "$DPDK" == true ] && echo " --dpdk")" "$NC"
printf '   binary : %s\n\n' "$BINARY"

# Pass BENCH_CONFIG through so the binary loads the same file we just read.
exec env BENCH_CONFIG="$CONFIG_FILE" "$BINARY"
