#!/usr/bin/env bash
# benchmarks/latency/lat — phase-10 dumb dispatcher.
#
#     sudo ./benchmarks/latency/lat <scenario> [--dpdk] [--config <path>]
#
# Per .artifacts/plan-phase-10-latency-bench-20260411-040540.md
# §Interface design → "lat script 职责". This wrapper is intentionally
# minimal: it validates argv, does the host-level NIC state transition
# (kernel ↔ vfio-pci), forks the Python echo/push mock, then execs the
# matching `lat_<scenario>[_dpdk]` binary and cleans up on exit.
#
# All measurement / reporting logic lives inside the C++ binary. The
# wrapper does *not* parse measurement output — it just runs the binary
# and propagates its exit code.
#
# Idempotency: reruns of the same scenario in the same mode take the
# fast path (NIC state matches → no transition).

set -euo pipefail

# ── Paths ────────────────────────────────────────────────────────────
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if PROJECT_DIR=$(git -C "$SCRIPT_DIR" rev-parse --show-toplevel 2>/dev/null); then
    :
else
    PROJECT_DIR="$(cd "$SCRIPT_DIR/../.." && pwd)"
fi
DEFAULT_CONFIG="$PROJECT_DIR/benchmarks/latency/bench.conf"
MOCKS_DIR="$PROJECT_DIR/benchmarks/latency/mocks"
DPDK_SETUP="$PROJECT_DIR/eph-dpdk/scripts/dpdk-setup.sh"
DPDK_TEARDOWN="$PROJECT_DIR/eph-dpdk/scripts/dpdk-teardown.sh"

# ── Valid scenarios + their mock script names ───────────────────────
declare -A SCENARIO_MOCKS=(
    [tcp]=tcp_echo.py
    [udp]=udp_echo.py
    [ws]=ws_echo.py
    [ex_market]=ex_market_push.py
    [ex_order]=ex_order_echo.py
    [ex_md_udp]=ex_md_udp_push.py
)

# ── Logging ──────────────────────────────────────────────────────────
if [[ -t 1 ]] && [[ -z "${NO_COLOR:-}" ]]; then
    RED=$'\033[0;31m'; GREEN=$'\033[0;32m'; YELLOW=$'\033[1;33m'
    CYAN=$'\033[0;36m'; BOLD=$'\033[1m'; NC=$'\033[0m'
else
    RED=''; GREEN=''; YELLOW=''; CYAN=''; BOLD=''; NC=''
fi
log_info()  { printf '%s[OK]%s %s\n' "$GREEN" "$NC" "$*"; }
log_step()  { printf '%s[..]%s %s\n' "$CYAN"  "$NC" "$*"; }
log_warn()  { printf '%s[!!]%s %s\n' "$YELLOW" "$NC" "$*" >&2; }
log_error() { printf '%s[XX]%s %s%s%s\n' "$RED" "$NC" "$BOLD" "$*" "$NC" >&2; }
die() { log_error "$1"; [[ -n "${2:-}" ]] && printf '     %s\n' "$2" >&2; exit 1; }

usage() {
    cat <<EOF
${BOLD}lat${NC} — Phase-10 latency benchmark runner

  ${BOLD}sudo ./benchmarks/latency/lat <scenario> [options]${NC}

SCENARIOS:
  tcp           raw TCP echo RTT
  udp           raw UDP echo RTT
  ws            plain WebSocket echo RTT           (Sub-phase 10.4+)
  ex_market     exchange bookTicker push (one-way) (Sub-phase 10.4+)
  ex_order      exchange N-inflight order RTT      (Sub-phase 10.5+)
  ex_md_udp     exchange UDP market data push      (Sub-phase 10.5+)

OPTIONS:
  --dpdk              use the DPDK client variant (NIC_B → vfio-pci)
  --config <path>     override bench.conf path (default: $DEFAULT_CONFIG)
  -h, --help          show this help

The wrapper forks the matching Python mock from $MOCKS_DIR,
execs the client binary built under build/linux/<arch>/release/lat_<scenario>,
and restores NIC state on exit. All measurement numbers come from the binary's
stdout — this script does not touch them.
EOF
}

# ── Parse argv ───────────────────────────────────────────────────────
SCENARIO=""
DPDK=false
CONFIG_FILE="$DEFAULT_CONFIG"
while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help) usage; exit 0 ;;
        --dpdk)    DPDK=true; shift ;;
        --config)  [[ $# -ge 2 ]] || die "--config requires a path"
                   CONFIG_FILE="$2"; shift 2 ;;
        -*)        die "unknown flag: $1" "Run $0 --help" ;;
        *)         [[ -z "$SCENARIO" ]] || die "unexpected positional: $1"
                   SCENARIO="$1"; shift ;;
    esac
done
[[ -n "$SCENARIO" ]] || { usage; exit 1; }
[[ -n "${SCENARIO_MOCKS[$SCENARIO]:-}" ]] || \
    die "unknown scenario: $SCENARIO" "Run $0 --help for the list"

# ── Environment sanity ──────────────────────────────────────────────
command -v python3 >/dev/null 2>&1 || \
    die "python3 not found in PATH" "The mock servers are Python stdlib scripts."
[[ -f "$CONFIG_FILE" ]] || die "config not found: $CONFIG_FILE"

MOCK_SCRIPT="$MOCKS_DIR/${SCENARIO_MOCKS[$SCENARIO]}"
[[ -f "$MOCK_SCRIPT" ]] || die "mock script missing: $MOCK_SCRIPT" \
    "Expected benchmarks/latency/mocks/${SCENARIO_MOCKS[$SCENARIO]} (added in sub-phase 10.2)."

# ── Locate the client binary ────────────────────────────────────────
detect_build_dir() {
    for d in \
        "$PROJECT_DIR/build/linux/arm64/release" \
        "$PROJECT_DIR/build/linux/aarch64/release" \
        "$PROJECT_DIR/build/linux/x86_64/release"; do
        [[ -d "$d" ]] && { echo "$d"; return; }
    done
    die "cannot find xmake build dir under $PROJECT_DIR/build/linux/*/release"
}
BUILD_DIR=$(detect_build_dir)

BIN_NAME="lat_${SCENARIO}"
$DPDK && BIN_NAME="${BIN_NAME}_dpdk"
BINARY="$BUILD_DIR/$BIN_NAME"
[[ -x "$BINARY" ]] || die "binary not found: $BINARY" "Build with: xmake build $BIN_NAME"

# ── Root-only (needed for NIC state transitions AND binding privileged
#    ports; the smoke-loopback path can skip this if the user really
#    wants to run unprivileged, but the default config uses port <1024
#    sometimes, so we keep it strict) ───────────────────────────────
[[ $EUID -eq 0 ]] || die "must run as root" "sudo $0 $SCENARIO $*"

# ── Parse minimal fields from bench.conf ────────────────────────────
# The binary reads the full file via --config; we only need a handful
# of lowercase globals here for the NIC transition. Grep + cut is enough
# (no nested sections matter because we read before the first `[...]`).
conf_get() {
    local key="$1" default="${2:-}"
    # Pick only pre-`[...]` lines, then the first `key = value` that matches.
    local val
    val=$(awk -v k="$key" '
        /^\[/ { exit }
        /^[[:space:]]*#/ { next }
        {
            sub(/#.*$/, "")        # trim inline comments
            split($0, a, "=")
            gsub(/^[[:space:]]+|[[:space:]]+$/, "", a[1])
            gsub(/^[[:space:]]+|[[:space:]]+$/, "", a[2])
            if (a[1] == k) { print a[2]; exit }
        }
    ' "$CONFIG_FILE")
    [[ -n "$val" ]] && echo "$val" || echo "$default"
}

MOCK_NIC=$(conf_get mock_nic)
CLIENT_NIC=$(conf_get client_nic)
MOCK_IP=$(conf_get mock_ip)
CLIENT_IP=$(conf_get client_ip)
NETMASK=$(conf_get netmask 255.255.255.0)
NIC_B_PCI=$(conf_get NIC_B_PCI)   # uppercase — reuse existing bench.conf key

# ── Decide desired NIC-B state ──────────────────────────────────────
DESIRED="host"
$DPDK && DESIRED="dpdk"

# Helper: current state of CLIENT_NIC (or NIC_B when pulled from uppercase).
nic_pci() {
    # Prefer explicit NIC_B_PCI. Fall back to sysfs.
    if [[ -n "$NIC_B_PCI" ]]; then
        echo "$NIC_B_PCI"; return
    fi
    if [[ -n "$CLIENT_NIC" && -e "/sys/class/net/$CLIENT_NIC/device" ]]; then
        basename "$(readlink -f "/sys/class/net/$CLIENT_NIC/device")"
        return
    fi
    echo ""
}

detect_state() {
    local pci drv
    pci=$(nic_pci)
    if [[ -n "$pci" ]]; then
        drv=$(basename "$(readlink -f "/sys/bus/pci/devices/$pci/driver" 2>/dev/null)" 2>/dev/null || echo "")
        [[ "$drv" == "vfio-pci" ]] && { echo "dpdk"; return; }
    fi
    if [[ -n "$CLIENT_NIC" ]] && ip link show "$CLIENT_NIC" &>/dev/null; then
        echo "host"; return
    fi
    # No client NIC configured at all → treat as loopback-only. The
    # binary will send to mock_ip=127.0.0.1 if the config says so.
    echo "loopback"
}

# ── State transitions ────────────────────────────────────────────────
assign_ip_if_needed() {
    local nic="$1" ip="$2"
    [[ -n "$nic" && -n "$ip" ]] || return 0
    # Skip when the NIC already has that /24 (or whatever netmask) IP.
    if ip -4 addr show "$nic" 2>/dev/null | grep -qw "$ip"; then
        return 0
    fi
    local cidr="${ip}/${NETMASK##*.}"   # crude mask → prefix; good enough for /24
    # Fallback: derive prefix from dotted mask if the crude trick fails.
    case "$NETMASK" in
        255.255.255.0)   cidr="${ip}/24" ;;
        255.255.0.0)     cidr="${ip}/16" ;;
        255.0.0.0)       cidr="${ip}/8"  ;;
        255.255.255.255) cidr="${ip}/32" ;;
    esac
    log_step "assign $cidr to $nic"
    ip addr add "$cidr" dev "$nic" 2>/dev/null || true
    ip link set "$nic" up 2>/dev/null || true
}

host_to_dpdk() {
    [[ -x "$DPDK_SETUP" ]] || die "dpdk-setup.sh not found at $DPDK_SETUP"
    local pci; pci=$(nic_pci)
    [[ -n "$pci" ]] || die "cannot determine PCI BDF for client NIC" \
        "Set NIC_B_PCI=0000:XX:YY.Z in $CONFIG_FILE."
    log_step "NIC $CLIENT_NIC → vfio-pci (PCI $pci)"
    DPDK_PCI="$pci" DPDK_IFACE="$CLIENT_NIC" "$DPDK_SETUP" -y || \
        die "dpdk-setup.sh failed" \
            "Run 'sudo $DPDK_SETUP --check-only' to diagnose."
    log_info "$CLIENT_NIC bound to vfio-pci"
}

dpdk_to_host() {
    [[ -x "$DPDK_TEARDOWN" ]] || die "dpdk-teardown.sh not found at $DPDK_TEARDOWN"
    log_step "NIC $CLIENT_NIC → kernel driver"
    "$DPDK_TEARDOWN" || die "dpdk-teardown.sh failed" \
        "A live DPDK process may still be holding the device."
    log_info "$CLIENT_NIC back on kernel driver"
}

CURRENT=$(detect_state)
log_info "client NIC state: $CURRENT → desired: $DESIRED"

case "$CURRENT,$DESIRED" in
    loopback,host|loopback,dpdk)
        # No client NIC at all — trust bench.conf's mock_ip. If the user
        # asked for DPDK with no NIC configured, that's an error.
        $DPDK && die "--dpdk requested but no client NIC in $CONFIG_FILE" \
            "Set client_nic= and NIC_B_PCI= (or keep it unset and drop --dpdk)."
        log_warn "no client_nic configured — running loopback-only"
        ;;
    host,host)   : ;;   # already good
    dpdk,dpdk)   : ;;   # already good
    host,dpdk)   host_to_dpdk ;;
    dpdk,host)   dpdk_to_host ;;
    *)           die "unhandled NIC state transition: $CURRENT → $DESIRED" ;;
esac

# Assign IPs for kernel mode (mock NIC in host ns serves the mock; client NIC
# needs its IP so the kernel routes outgoing packets to mock_ip via CLIENT_NIC).
if [[ "$DESIRED" == "host" ]]; then
    assign_ip_if_needed "$MOCK_NIC"   "$MOCK_IP"
    assign_ip_if_needed "$CLIENT_NIC" "$CLIENT_IP"
fi

# ── Fork the Python mock + exec the client binary ────────────────────
MOCK_PID=""
cleanup() {
    local rc=$?
    if [[ -n "$MOCK_PID" ]] && kill -0 "$MOCK_PID" 2>/dev/null; then
        kill -TERM "$MOCK_PID" 2>/dev/null || true
        # Give it 500 ms to exit cleanly, then SIGKILL.
        for _ in 1 2 3 4 5; do
            kill -0 "$MOCK_PID" 2>/dev/null || break
            sleep 0.1
        done
        kill -0 "$MOCK_PID" 2>/dev/null && kill -KILL "$MOCK_PID" 2>/dev/null || true
        wait "$MOCK_PID" 2>/dev/null || true
    fi
    exit $rc
}
trap cleanup EXIT INT TERM

printf '\n%s── lat %s%s ──%s\n' "$BOLD" "$SCENARIO" \
    "$($DPDK && echo ' --dpdk')" "$NC"
printf '   binary : %s\n'   "$BINARY"
printf '   mock   : %s\n'   "$MOCK_SCRIPT"
printf '   config : %s\n\n' "$CONFIG_FILE"

log_step "forking mock: python3 $(basename "$MOCK_SCRIPT") --config $(basename "$CONFIG_FILE")"
python3 "$MOCK_SCRIPT" --config "$CONFIG_FILE" &
MOCK_PID=$!

# Give the mock 500 ms to bind its listening socket before the client
# tries to connect/send. A proper handshake would be better, but Python
# stdlib servers hit `listen()` in well under that.
sleep 0.5

if ! kill -0 "$MOCK_PID" 2>/dev/null; then
    die "mock exited before client could run" \
        "Check the mock output above; it probably failed to bind $MOCK_IP."
fi

log_step "exec client: $BIN_NAME --config $(basename "$CONFIG_FILE")"
set +e
"$BINARY" --config "$CONFIG_FILE"
CLIENT_RC=$?
set -e

# cleanup (via trap) will reap the mock and propagate $CLIENT_RC through $?.
exit "$CLIENT_RC"
