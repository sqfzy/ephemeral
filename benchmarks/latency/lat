#!/usr/bin/env bash
# benchmarks/latency/lat — fair-topology latency benchmark runner.
#
#     sudo ./benchmarks/latency/lat <scenario> [--dpdk] [--config <path>]
#
# This wrapper drives the per-run NIC state machine + mock fork + client
# exec. It combines the pre-v3.3 baseline's bench_ns state machine
# (restored in the Phase-10 fairness fix) with the Phase-10 Python mock
# fork model.
#
# ── Fairness contract ───────────────────────────────────────────────
#
# For the kernel-vs-DPDK latency comparison to be fair, both backends
# must traverse the *same physical path*:
#
#     client [ens35] --[wire]--> AWS VPC --[wire]--> [ens34] mock
#
# The only thing that differs between kernel and DPDK modes is the
# client-side code path (kernel TCP/UDP stack vs DPDK PMD). The mock
# is always kernel Python, bound to ens34's IP in the host ns.
#
# Kernel mode uses a Linux network namespace (`bench_ns`) to prevent
# the kernel from shortcutting ens34 ↔ ens35 via loopback when both
# NICs live in the same ns. Both ens34 (172.31.21.173) and ens35
# (172.31.23.112) are on the same /20 VPC subnet; without the netns
# split, Linux would deliver packets via the loopback input path and
# the measured latency would not reflect reality.
#
# DPDK mode binds ens35 to vfio-pci so DPDK PMDs own the hardware
# queue. The measurement is equally fair because the mock side is
# still a kernel process serving on ens34.
#
# ── State machine ───────────────────────────────────────────────────
#
#     host      ens35 in default ns, kernel driver
#     bench_ns  ens35 moved into netns bench_ns (kernel mode run path)
#     dpdk      ens35 bound to vfio-pci                (dpdk mode run path)
#     wedged    kernel driver bound but no netdev (transient race)
#
# Transitions are idempotent — reruns of the same scenario in the same
# mode take the fast path (no change).
#
# History: Phase 7 removed the eph-dpdk module; the dpdk-setup.sh +
# dpdk-teardown.sh helpers live at benchmarks/latency/scripts/ now.

set -euo pipefail

# ── Paths ────────────────────────────────────────────────────────────
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if PROJECT_DIR=$(git -C "$SCRIPT_DIR" rev-parse --show-toplevel 2>/dev/null); then
    :
else
    PROJECT_DIR="$(cd "$SCRIPT_DIR/../.." && pwd)"
fi
DEFAULT_CONFIG="$PROJECT_DIR/benchmarks/latency/bench.conf"
MOCKS_DIR="$PROJECT_DIR/benchmarks/latency/mocks"
DPDK_SETUP="$PROJECT_DIR/benchmarks/latency/scripts/dpdk-setup.sh"
DPDK_TEARDOWN="$PROJECT_DIR/benchmarks/latency/scripts/dpdk-teardown.sh"

# ── Valid scenarios + their mock script names ───────────────────────
declare -A SCENARIO_MOCKS=(
    [tcp]=tcp_echo.py
    [udp]=udp_echo.py
    [ws]=ws_echo.py
    [ex_market]=ex_market_push.py
    [ex_order]=ex_order_echo.py
    [ex_md_udp]=ex_md_udp_echo.py
    [ex_market_2p]=ex_market_2p_push.py
)

# ── Logging ──────────────────────────────────────────────────────────
if [[ -t 1 ]] && [[ -z "${NO_COLOR:-}" ]]; then
    RED=$'\033[0;31m'; GREEN=$'\033[0;32m'; YELLOW=$'\033[1;33m'
    CYAN=$'\033[0;36m'; BOLD=$'\033[1m'; NC=$'\033[0m'
else
    RED=''; GREEN=''; YELLOW=''; CYAN=''; BOLD=''; NC=''
fi
log_info()  { printf '%s[OK]%s %s\n' "$GREEN" "$NC" "$*"; }
log_step()  { printf '%s[..]%s %s\n' "$CYAN"  "$NC" "$*"; }
log_warn()  { printf '%s[!!]%s %s\n' "$YELLOW" "$NC" "$*" >&2; }
log_error() { printf '%s[XX]%s %s%s%s\n' "$RED" "$NC" "$BOLD" "$*" "$NC" >&2; }
die() { log_error "$1"; [[ -n "${2:-}" ]] && printf '     %s\n' "$2" >&2; exit 1; }

usage() {
    cat <<EOF
${BOLD}lat${NC} — fair-topology latency benchmark runner

  ${BOLD}sudo ./benchmarks/latency/lat <scenario> [options]${NC}

SCENARIOS:
  tcp           raw TCP echo RTT
  udp           raw UDP echo RTT
  ws            plain WebSocket echo RTT
  ex_market     exchange bookTicker push (one-way)
  ex_order      exchange N-inflight order RTT
  ex_md_udp     exchange UDP market data push

OPTIONS:
  --dpdk              use the DPDK client variant (NIC_B → vfio-pci)
  --config <path>     override bench.conf path (default: $DEFAULT_CONFIG)
  -h, --help          show this help

Kernel mode runs the client inside network namespace \`bench_ns\` so that
the client NIC cannot shortcut loopback to the mock NIC — both sides
traverse the physical wire via the AWS VPC fabric. DPDK mode binds the
client NIC to vfio-pci. The Python mock always runs in the host ns.

Loopback-only fallback: if client_nic is left unset in bench.conf, the
wrapper skips the NIC state machine and runs the client in the host ns
(useful for quick smoke tests on a machine without a spare NIC).
EOF
}

# ── Parse argv ───────────────────────────────────────────────────────
SCENARIO=""
DPDK=false
CONFIG_FILE="$DEFAULT_CONFIG"
while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help) usage; exit 0 ;;
        --dpdk)    DPDK=true; shift ;;
        --config)  [[ $# -ge 2 ]] || die "--config requires a path"
                   CONFIG_FILE="$2"; shift 2 ;;
        -*)        die "unknown flag: $1" "Run $0 --help" ;;
        *)         [[ -z "$SCENARIO" ]] || die "unexpected positional: $1"
                   SCENARIO="$1"; shift ;;
    esac
done
[[ -n "$SCENARIO" ]] || { usage; exit 1; }
[[ -n "${SCENARIO_MOCKS[$SCENARIO]:-}" ]] || \
    die "unknown scenario: $SCENARIO" "Run $0 --help for the list"

# ── Environment sanity ──────────────────────────────────────────────
command -v python3 >/dev/null 2>&1 || \
    die "python3 not found in PATH" "The mock servers are Python stdlib scripts."
[[ -f "$CONFIG_FILE" ]] || die "config not found: $CONFIG_FILE"

MOCK_SCRIPT="$MOCKS_DIR/${SCENARIO_MOCKS[$SCENARIO]}"
[[ -f "$MOCK_SCRIPT" ]] || die "mock script missing: $MOCK_SCRIPT"

# ── Locate the client binary ────────────────────────────────────────
detect_build_dir() {
    for d in \
        "$PROJECT_DIR/build/linux/arm64/release" \
        "$PROJECT_DIR/build/linux/aarch64/release" \
        "$PROJECT_DIR/build/linux/x86_64/release"; do
        [[ -d "$d" ]] && { echo "$d"; return; }
    done
    die "cannot find xmake build dir under $PROJECT_DIR/build/linux/*/release"
}
BUILD_DIR=$(detect_build_dir)

BIN_NAME="lat_${SCENARIO}"
$DPDK && BIN_NAME="${BIN_NAME}_dpdk"
BINARY="$BUILD_DIR/$BIN_NAME"
[[ -x "$BINARY" ]] || die "binary not found: $BINARY" "Build with: xmake build $BIN_NAME"

[[ $EUID -eq 0 ]] || die "must run as root" "sudo $0 $SCENARIO $*"

# ── Parse minimal fields from bench.conf (lowercase globals only) ──
conf_get() {
    local key="$1" default="${2:-}"
    local val
    val=$(awk -v k="$key" '
        /^\[/ { exit }
        /^[[:space:]]*#/ { next }
        {
            sub(/#.*$/, "")
            split($0, a, "=")
            gsub(/^[[:space:]]+|[[:space:]]+$/, "", a[1])
            gsub(/^[[:space:]]+|[[:space:]]+$/, "", a[2])
            if (a[1] == k) { print a[2]; exit }
        }
    ' "$CONFIG_FILE")
    [[ -n "$val" ]] && echo "$val" || echo "$default"
}

MOCK_NIC=$(conf_get mock_nic)
CLIENT_NIC=$(conf_get client_nic)
MOCK_IP=$(conf_get mock_ip)
CLIENT_IP=$(conf_get client_ip)
NETMASK=$(conf_get netmask 255.255.255.0)
GATEWAY_IP=$(conf_get gateway_ip)
NIC_B_PCI=$(conf_get NIC_B_PCI)   # uppercase — reused from legacy BenchConfig

# dotted mask → CIDR prefix. Supports /20 (the AWS VPC default) plus
# the other common /8 /16 /24 /32 cases.
netmask_to_prefix() {
    case "$1" in
        255.255.255.255) echo 32 ;;
        255.255.255.0)   echo 24 ;;
        255.255.254.0)   echo 23 ;;
        255.255.252.0)   echo 22 ;;
        255.255.248.0)   echo 21 ;;
        255.255.240.0)   echo 20 ;;
        255.255.224.0)   echo 19 ;;
        255.255.192.0)   echo 18 ;;
        255.255.128.0)   echo 17 ;;
        255.255.0.0)     echo 16 ;;
        255.0.0.0)       echo 8 ;;
        *)               echo 24 ;;  # sensible default
    esac
}
PREFIX=$(netmask_to_prefix "$NETMASK")

# ── PCI / driver helpers (mirrors baseline lat semantics) ───────────
nic_b_pci() {
    if [[ -n "$NIC_B_PCI" ]]; then
        echo "$NIC_B_PCI"; return
    fi
    if [[ -n "$CLIENT_NIC" && -e "/sys/class/net/$CLIENT_NIC/device" ]]; then
        local pci
        pci=$(basename "$(readlink -f "/sys/class/net/$CLIENT_NIC/device")")
        [[ -n "$pci" && "$pci" != "device" ]] && { echo "$pci"; return; }
    fi
    if [[ -f "$PROJECT_DIR/.dpdk_state" ]] && \
       grep -q "DPDK_IFACE=\"$CLIENT_NIC\"" "$PROJECT_DIR/.dpdk_state" 2>/dev/null; then
        grep -oP 'DPDK_PCI="\K[^"]+' "$PROJECT_DIR/.dpdk_state"
        return
    fi
    echo ""
}

pci_driver() {
    local pci="$1"
    [[ -n "$pci" && -e "/sys/bus/pci/devices/$pci" ]] || { echo ""; return; }
    basename "$(readlink -f "/sys/bus/pci/devices/$pci/driver" 2>/dev/null)" 2>/dev/null || echo ""
}

pci_has_netdev() {
    local pci="$1"
    [[ -n "$pci" ]] || return 1
    [[ -n "$(ls "/sys/bus/pci/devices/$pci/net" 2>/dev/null)" ]]
}

unwedge_nic() {
    local pci drv
    pci=$(nic_b_pci)
    [[ -n "$pci" ]] || return 1
    drv=$(pci_driver "$pci")
    [[ -z "$drv" ]] && return 1
    if pci_has_netdev "$pci"; then
        return 0
    fi
    log_warn "$CLIENT_NIC (PCI $pci) is wedged: $drv bound but no netdev"
    log_step "auto-recovery: unbind/rebind $drv on $pci"
    echo "$pci" > "/sys/bus/pci/drivers/$drv/unbind" 2>/dev/null || true
    sleep 1
    echo "$pci" > "/sys/bus/pci/drivers/$drv/bind" 2>/dev/null || true
    for _ in 1 2 3 4 5 6; do
        if ip link show "$CLIENT_NIC" &>/dev/null; then
            log_info "wedge recovered: $CLIENT_NIC back in host ns"
            return 0
        fi
        sleep 0.5
    done
    return 1
}

detect_nic_b_state() {
    # bench_ns first — ip link show in host ns won't see a NIC that has
    # been moved to another netns, so we must check netns before sysfs.
    if [[ -n "$CLIENT_NIC" ]] && \
       ip netns list 2>/dev/null | grep -qw bench_ns && \
       ip netns exec bench_ns ip link show "$CLIENT_NIC" &>/dev/null; then
        echo "bench_ns"; return
    fi
    local pci drv
    pci=$(nic_b_pci)
    if [[ -n "$pci" ]]; then
        drv=$(pci_driver "$pci")
        if [[ "$drv" == "vfio-pci" ]]; then
            echo "dpdk"; return
        fi
        if [[ -n "$drv" ]] && ! pci_has_netdev "$pci"; then
            echo "wedged"; return
        fi
    fi
    if [[ -n "$CLIENT_NIC" ]] && ip link show "$CLIENT_NIC" &>/dev/null; then
        echo "host"; return
    fi
    echo "unknown"
}

wait_for_link() {
    local ns="$1" iface="$2" timeout_ds=${3:-20}
    for _ in $(seq 1 "$timeout_ds"); do
        if [[ -z "$ns" ]]; then
            ip link show "$iface" &>/dev/null && return 0
        else
            ip netns exec "$ns" ip link show "$iface" &>/dev/null && return 0
        fi
        sleep 0.1
    done
    return 1
}

# ── State transitions (idempotent) ───────────────────────────────────
host_to_bench_ns() {
    log_step "NIC-B: host → bench_ns"
    ip netns add bench_ns 2>/dev/null || true

    if ! ip netns exec bench_ns ip link show "$CLIENT_NIC" &>/dev/null; then
        # Drop any pre-existing IP on the NIC in host ns before moving it
        # (the move preserves link state but the interface may carry stale
        # addresses from DHCP).
        ip addr flush dev "$CLIENT_NIC" 2>/dev/null || true
        ip link set "$CLIENT_NIC" netns bench_ns
    fi

    # Assign static IP + bring up inside bench_ns (idempotent: `ip addr add`
    # fails if the address already exists, so `|| true`).
    ip netns exec bench_ns ip addr add "${CLIENT_IP}/${PREFIX}" dev "$CLIENT_NIC" 2>/dev/null || true
    ip netns exec bench_ns ip link set "$CLIENT_NIC" up
    ip netns exec bench_ns ip link set lo up
    # Default route via the configured gateway so packets with dst=mock_ip
    # (which lives on NIC-A in the host ns) actually go out the wire.
    if [[ -n "$GATEWAY_IP" ]]; then
        ip netns exec bench_ns ip route add default via "$GATEWAY_IP" dev "$CLIENT_NIC" 2>/dev/null || true
    fi

    # Bidirectional static ARP. AWS VPC does not proxy-ARP between two
    # ENIs on the same instance, so neither side can resolve the other via
    # broadcast ARP — SYNs and replies both black-hole. Inject permanent
    # neighbour entries in both directions:
    #   bench_ns: MOCK_IP  → mock NIC's MAC   (so client SYN goes out)
    #   host ns:  CLIENT_IP → client NIC's MAC (so mock SYN-ACK comes back)
    if [[ -n "$MOCK_NIC" && -n "$MOCK_IP" ]]; then
        local mock_mac client_mac
        mock_mac=$(ip -br link show "$MOCK_NIC" 2>/dev/null | awk '{print $3}')
        client_mac=$(ip netns exec bench_ns ip -br link show "$CLIENT_NIC" 2>/dev/null | awk '{print $3}')
        if [[ -n "$mock_mac" && -n "$client_mac" ]]; then
            ip netns exec bench_ns ip neigh replace "$MOCK_IP" \
                lladdr "$mock_mac" dev "$CLIENT_NIC" nud permanent 2>/dev/null || true
            ip neigh replace "$CLIENT_IP" \
                lladdr "$client_mac" dev "$MOCK_NIC" nud permanent 2>/dev/null || true
            log_info "static ARP: $MOCK_IP → $mock_mac, $CLIENT_IP → $client_mac"
        else
            log_warn "could not read MACs ($MOCK_NIC=$mock_mac, $CLIENT_NIC=$client_mac) — ARP may fail"
        fi
    fi

    log_info "bench_ns ready ($CLIENT_NIC = ${CLIENT_IP}/${PREFIX} → ${GATEWAY_IP:-no-gw})"
}

bench_ns_to_host() {
    log_step "NIC-B: bench_ns → host"
    ip netns exec bench_ns ip link set "$CLIENT_NIC" netns 1 2>/dev/null || true
    ip netns del bench_ns 2>/dev/null || true
    ip link set "$CLIENT_NIC" up 2>/dev/null || true
}

host_to_dpdk() {
    [[ -x "$DPDK_SETUP" ]] || die "dpdk-setup.sh not found at $DPDK_SETUP"
    local pci; pci=$(nic_b_pci)
    [[ -n "$pci" ]] || die "cannot determine PCI BDF for $CLIENT_NIC" \
        "Set NIC_B_PCI=0000:XX:YY.Z in $CONFIG_FILE."
    log_step "NIC $CLIENT_NIC → vfio-pci (PCI $pci)"
    if ! DPDK_PCI="$pci" DPDK_IFACE="$CLIENT_NIC" "$DPDK_SETUP" -y; then
        die "dpdk-setup.sh failed" \
            "Check the output above. Run 'sudo $DPDK_SETUP --check-only' to diagnose."
    fi
    local ok=false
    for _ in 1 2 3 4 5; do
        if ! ip link show "$CLIENT_NIC" &>/dev/null && \
           [[ "$(pci_driver "$pci")" == "vfio-pci" ]]; then
            ok=true; break
        fi
        sleep 0.2
    done
    $ok || die "dpdk-setup reported success but $CLIENT_NIC is still a kernel interface"
    log_info "$CLIENT_NIC (PCI $pci) bound to vfio-pci"
}

dpdk_to_host() {
    [[ -x "$DPDK_TEARDOWN" ]] || die "dpdk-teardown.sh not found at $DPDK_TEARDOWN"
    log_step "NIC $CLIENT_NIC → kernel driver"
    if ! "$DPDK_TEARDOWN"; then
        die "dpdk-teardown.sh failed — NIC-B still bound to vfio-pci" \
            "A DPDK process may be holding the device. Check 'ps -ef | grep -i dpdk'."
    fi
    if ! wait_for_link "" "$CLIENT_NIC" 20; then
        if unwedge_nic && wait_for_link "" "$CLIENT_NIC" 20; then
            :
        else
            die "teardown succeeded but $CLIENT_NIC is not back in host ns"
        fi
    fi
}

assign_mock_ip_if_needed() {
    # Mock side: ens34 in host ns. This is typically the primary ENI and
    # already has its DHCP address (172.31.21.173). This helper exists in
    # case a tester is running on a one-NIC dev box and wants to stub
    # mock_nic to lo or a dummy.
    [[ -n "$MOCK_NIC" && -n "$MOCK_IP" ]] || return 0
    if ip -4 addr show "$MOCK_NIC" 2>/dev/null | grep -qw "$MOCK_IP"; then
        return 0
    fi
    log_step "assign ${MOCK_IP}/${PREFIX} to $MOCK_NIC"
    ip addr add "${MOCK_IP}/${PREFIX}" dev "$MOCK_NIC" 2>/dev/null || true
    ip link set "$MOCK_NIC" up 2>/dev/null || true
}

# ── Decide desired state + drive transitions ────────────────────────
# Loopback fallback: if no client_nic is set at all, skip the state machine
# entirely (useful for laptop smoke tests without a second NIC).
if [[ -z "$CLIENT_NIC" ]]; then
    $DPDK && die "--dpdk requested but no client_nic in $CONFIG_FILE"
    log_warn "no client_nic configured — running loopback-only (NOT fair for DPDK comparison)"
    LOOPBACK_ONLY=true
else
    LOOPBACK_ONLY=false
fi

if [[ "$LOOPBACK_ONLY" == false ]]; then
    DESIRED="bench_ns"
    $DPDK && DESIRED="dpdk"

    CURRENT=$(detect_nic_b_state)
    log_info "NIC-B current: $CURRENT  →  desired: $DESIRED"

    if [[ "$CURRENT" == "wedged" ]]; then
        log_warn "NIC-B wedged; attempting auto-recovery"
        unwedge_nic || die "auto-recovery failed for $CLIENT_NIC"
        CURRENT=$(detect_nic_b_state)
        log_info "NIC-B post-recovery: $CURRENT"
    fi

    case "$CURRENT,$DESIRED" in
        bench_ns,bench_ns|dpdk,dpdk) : ;;
        host,bench_ns)     host_to_bench_ns ;;
        host,dpdk)         host_to_dpdk ;;
        bench_ns,dpdk)     bench_ns_to_host; host_to_dpdk ;;
        dpdk,bench_ns)     dpdk_to_host; host_to_bench_ns ;;
        unknown,*)         die "cannot determine $CLIENT_NIC state" \
                               "Tried bench_ns, sysfs PCI, host kernel netdev. None matched." ;;
        *)                 die "unhandled transition: $CURRENT → $DESIRED" ;;
    esac

    assign_mock_ip_if_needed
fi

# ── Fork the Python mock (always in host ns) + exec the client ──────
MOCK_PID=""
cleanup() {
    local rc=$?
    if [[ -n "$MOCK_PID" ]] && kill -0 "$MOCK_PID" 2>/dev/null; then
        kill -TERM "$MOCK_PID" 2>/dev/null || true
        for _ in 1 2 3 4 5; do
            kill -0 "$MOCK_PID" 2>/dev/null || break
            sleep 0.1
        done
        kill -0 "$MOCK_PID" 2>/dev/null && kill -KILL "$MOCK_PID" 2>/dev/null || true
        wait "$MOCK_PID" 2>/dev/null || true
    fi
    exit $rc
}
trap cleanup EXIT INT TERM

printf '\n%s── lat %s%s ──%s\n' "$BOLD" "$SCENARIO" \
    "$($DPDK && echo ' --dpdk')" "$NC"
printf '   binary : %s\n'   "$BINARY"
printf '   mock   : %s\n'   "$MOCK_SCRIPT"
printf '   config : %s\n'   "$CONFIG_FILE"
printf '   topo   : %s\n\n' \
    "$([[ "$LOOPBACK_ONLY" == true ]] && echo loopback-only || \
       $DPDK && echo "dpdk(ens35=vfio) → VPC → mock(ens34)" || \
       echo "bench_ns(ens35) → VPC → mock(ens34)")"

log_step "forking mock: python3 $(basename "$MOCK_SCRIPT") --config $(basename "$CONFIG_FILE")"
python3 "$MOCK_SCRIPT" --config "$CONFIG_FILE" &
MOCK_PID=$!

sleep 0.5

if ! kill -0 "$MOCK_PID" 2>/dev/null; then
    die "mock exited before client could run" \
        "Check the mock output above; it probably failed to bind $MOCK_IP."
fi

# ── Exec the client ─────────────────────────────────────────────────
# kernel mode: run the client inside bench_ns so the kernel can't take
# the loopback shortcut between ens34 ↔ ens35 via lo.
# dpdk mode: run in host ns (DPDK EAL needs to open vfio devices; netns
# ownership of PCI devices would actually defeat that).
# loopback fallback: also runs in host ns.
log_step "exec client: $BIN_NAME --config $(basename "$CONFIG_FILE")"
set +e
if [[ "$LOOPBACK_ONLY" == false && "$DPDK" == false ]]; then
    ip netns exec bench_ns "$BINARY" --config "$CONFIG_FILE"
else
    "$BINARY" --config "$CONFIG_FILE"
fi
CLIENT_RC=$?
set -e

exit "$CLIENT_RC"
