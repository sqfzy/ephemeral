#!/usr/bin/env bpftrace
/*
 * cross_core_check.bt —— 业务流"软中断协议栈核 == app recv 核"观测
 *
 * 入参（位置参数）:
 *   $1 = 业务网卡 ifindex (如 ens6 = 3)
 *   $2 = 业务/exchange 源端口 (如 443)
 *   $3 = 业务线程 comm (如 "bybit_race"; ≤ 15 字节, 超出被 TASK_COMM_LEN-1 截断)
 *
 * 两层 hook —— 取收包路径上真正决定 cache 局部性的两个核:
 *   kprobe:tcp_v4_rcv (skb_iif==$1 && sport==$2)   → ① softirq 协议栈 CPU
 *       skb 被持 socket lock 入 sk_receive_queue 的核 ("生产"). 已过 RPS 决策点
 *       且 skb_iif 已赋值, 可按网卡 + 源端口精确过滤到业务流.
 *   kretprobe:tcp_recvmsg (comm==$3, ret>0)        → ② 业务线程 recvmsg CPU
 *       copy_to_user 出队的核 ("消费"), 即 app 核.
 *
 * 为什么只看这两层 (不挂 NAPI poll):
 *   真正会跨核弹跳的热数据是 socket 接收队列 + socket lock + skb 元数据 —— ① 持锁入队、
 *   ② 持锁出队 + copy. 这条 ①↔② 生产者→消费者边界才是跨核代价的大头. NAPI poll 只读
 *   包头 / 建 skb / 跑 GRO, 不 copy payload、不碰 socket 队列, 且正常情况下 NAPI 与
 *   tcp_v4_rcv 跑在同一次 softirq、同一个核 (唯一能拆开的是 RPS). 故 NAPI 落核不是承重
 *   判据, 不值得在收包热路径上多挂一个探针.
 *
 *   附带影响: 去掉 NAPI 层后, ①≠② 时无法直接区分"RPS 搬核"还是"RSS/IRQ 没对齐到 app
 *   核" —— 但两者都表现为业务流软中断没落在 app 核上, ① 已能测出. 真要区分根因时再单独
 *   挂 tracepoint:net:napi_gro_receive_entry 看源头 CPU.
 *
 * 输出 map:
 *   @softirq_cpu[cpu]   业务流 RX softirq 落核 (已按 skb_iif + sport 过滤干净).  ① 主判据
 *   @recv_cpu[cpu]      业务线程 recvmsg 落核 (已按 comm 过滤干净).             ② 主判据
 *   @recv_calls         业务 recvmsg 命中数; = 0 暗示 comm 过滤未命中 (即时诊断).
 *
 * 判定（harness 应执行的逻辑）:
 *   softirq_cpu_set := { cpu | @softirq_cpu[cpu] > 0 }
 *   recv_cpu_set    := { cpu | @recv_cpu[cpu] > 0 }
 *
 *   两集合都恰为单一 CPU, 彼此相等, 且 == 业务核
 *     → PASS (软中断在 app 核生产、app 核消费, socket 队列不跨核弹跳)
 *
 *   softirq_cpu_set != recv_cpu_set  → 业务流软中断没落在 app 核 → FAIL
 *                                       (查 RSS 队列 → IRQ affinity 是否对齐到 app 核;
 *                                        或 RPS 把 skb 搬走了)
 *   |softirq_cpu_set| > 1            → 业务流软中断分布多核 (RSS 配置错) → FAIL
 *   |recv_cpu_set| > 1               → 业务线程在迁移 → FAIL (检查 affinity)
 *
 * 注意:
 *   - 收包热路径挂 kprobe/kretprobe 有 ~50-200ns 探针开销; 本脚本仅判"是否同核"布尔量,
 *     不可用于报延迟绝对值.
 *   - $3 comm 超过 15 字节会被截断 → @recv_calls = 0; 用前 15 字节做 $3.
 *   - retval 是 uint64 但内核 tcp_recvmsg 返回 int (32 位): 必须 (int32)retval 强制符号
 *     扩展, 否则负 errno 高位 garbage 会穿透 ret>0 过滤.
 *   - 若 kretprobe:tcp_recvmsg attach 失败 (内核内联), fallback:
 *       kfunc:tcp_recvmsg 或 fentry:tcp_recvmsg (kernel ≥ 5.5).
 *   - 仅覆盖 IPv4 TCP (tcp_v4_rcv); IPv6 业务流需改挂 tcp_v6_rcv.
 *   - 最低内核版本: 5.4. 最低 bpftrace 版本: 0.14.
 */

BEGIN {
    printf("cross_core_check started: ifindex=%d sport=%d comm=%s (Ctrl-C 退出并 dump map)\n",
           $1, $2, str($3));
}

// ① softirq 协议栈 CPU —— skb 持锁入 sk_receive_queue, 按业务网卡 + 源端口过滤
kprobe:tcp_v4_rcv {
    $skb = (struct sk_buff *)arg0;
    if ($skb->skb_iif == $1) {
        $head = $skb->head;
        $tcph = (struct tcphdr *)($head + $skb->transport_header);
        $sport = (uint16)(($tcph->source >> 8) | ($tcph->source << 8)); // ntohs
        if ($sport == (uint16)$2) {
            @softirq_cpu[cpu] = count();
        }
    }
}

// ② 业务线程 recvmsg CPU —— (int32)retval 符号扩展后再判 ret>0
kretprobe:tcp_recvmsg / comm == str($3) / {
    $ret = (int32)retval;
    if ($ret > 0) {
        @recv_cpu[cpu] = count();
        @recv_calls = count();
    }
}
